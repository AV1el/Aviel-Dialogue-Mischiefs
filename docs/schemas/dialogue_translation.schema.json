{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AV1el/Aviel-Dialogue-Mischiefs/docs/schemas/dialogue_translation.schema.json",
  "title": "ADM Dialogue Translation",
  "description": "Text-only overlay stored at dialogues/langs/<language>/<dialogue>.json.",
  "type": "object",
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "speaker": { "type": "string", "maxLength": 80 },
    "nodes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/nodeTranslation" }
    }
  },
  "definitions": {
    "nodeTranslation": {
      "type": "object",
      "properties": {
        "speaker": { "type": "string", "maxLength": 80 },
        "text": {
          "oneOf": [
            { "type": "string", "maxLength": 1200 },
            { "type": "array", "items": { "type": "string", "maxLength": 500 } }
          ]
        },
        "choices": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": { "type": "string", "maxLength": 140 }
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string", "maxLength": 140 },
                  {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string", "maxLength": 80 },
                      "text": { "type": "string", "maxLength": 140 },
                      "label": { "type": "string", "maxLength": 140 }
                    },
                    "anyOf": [
                      { "required": ["text"] },
                      { "required": ["label"] }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
